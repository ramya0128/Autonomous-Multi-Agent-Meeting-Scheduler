# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Calendar Backend ('fake' or 'google')
CALENDAR_BACKEND=fake

# Google Calendar OAuth (Required if CALENDAR_BACKEND=google)
GOOGLE_CLIENT_SECRET_FILE=data/credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=data/google_calendar_token.json